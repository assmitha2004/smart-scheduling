# ---- docker compose ----
JWT_SECRET=change-me-to-a-long-random-string
POSTGRES_PASSWORD=postgres
# AI: "rules" keeps everything local. Set to "anthropic" + an API key to let
# users who opt in (Settings > AI & privacy) use Claude for extraction/briefings.
AI_PROVIDER=rules
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Shared secret between backend and AI service (required on Vercel, optional locally)
AI_SERVICE_TOKEN=

# ---- backend (local dev: copy to backend/.env) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_scheduling
REDIS_URL=redis://localhost:6379
# Run BullMQ workers inside the API process (dev convenience)
INLINE_WORKER=true
CORS_ORIGIN=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000
PLANNING_HORIZON_DAYS=28
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
