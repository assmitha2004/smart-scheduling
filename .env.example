# ---- docker compose ----
JWT_SECRET=change-me-to-a-long-random-string
POSTGRES_PASSWORD=postgres
# AI: "ollama" runs an open-source model on your own server (docker compose
# starts Ollama and pulls OLLAMA_MODEL). "rules" uses no model at all.
# "anthropic" + an API key lets users who opt in (Settings > AI & privacy) use Claude.
AI_PROVIDER=ollama
# qwen2.5:7b-instruct (~5 GB, needs ~8 GB RAM) is a good default.
# Smaller servers: llama3.2:3b or qwen2.5:3b-instruct. With a GPU: qwen2.5:14b-instruct.
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_URL=http://localhost:11434
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Shared secret between backend and AI service (required on Vercel, optional locally)
AI_SERVICE_TOKEN=

# ---- assistant: Google Calendar/Meet + Gmail (see README "Assistant") ----
# OAuth client from Google Cloud Console (type: Web application). Authorized redirect URI:
#   $APP_URL/api/v1/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where the app is served (OAuth redirects back here)
APP_URL=http://localhost:8080
# 32 random bytes as hex, encrypts Google refresh tokens: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# Shared secret between the backend and the MCP service: openssl rand -hex 24
MCP_INTERNAL_TOKEN=change-me-too
# Set to false to hide the "Try with a sample inbox" option
ASSISTANT_DEMO=true

# ---- backend (local dev: copy to backend/.env) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_scheduling
REDIS_URL=redis://localhost:6379
# Run BullMQ workers inside the API process (dev convenience)
INLINE_WORKER=true
CORS_ORIGIN=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000
PLANNING_HORIZON_DAYS=28
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
