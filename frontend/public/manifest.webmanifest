{
  "name": "Smart Scheduling",
  "short_name": "Smart Sched",
  "description": "Plan your days, weeks and month in minutes. For students, professionals and everyone doing both.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f6f7fb",
  "theme_color": "#4f46e5",
  "categories": ["productivity", "education"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Plan my day", "url": "/app/plan?horizon=DAY", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Calendar", "url": "/app/calendar", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
